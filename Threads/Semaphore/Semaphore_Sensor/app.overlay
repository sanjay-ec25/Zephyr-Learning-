/ {
	aliases {
		adxl = &axl_node;
		mpu = &mpu_node;
	};
};

&i2c1 {
	mpu_node: mpu6050@68 {
		compatible = "invensense,mpu6050";
		reg = <0x68>;
		status = "okay";
	};
};

&i2c3 {
	pinctrl-0 = <&i2c3_scl_pa8 &i2c3_sda_pb4>;
	pinctrl-names = "default";
	status = "okay";
	clock-frequency = <I2C_BITRATE_FAST>;

	axl_node: axl345@53 {
		compatible = "adi,adxl345";
		reg = <0x53>;
		status = "okay";
	};
};
